{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "eas-test": {
      "withoutCredentials": true,
      "environment": "preview",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {}
  }
}
